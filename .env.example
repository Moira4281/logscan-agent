# LLM API 配置
# 兼容 OpenAI 接口的任意服务。注意：OPENAI_BASE_URL 填到 /v1 即可，
# SDK 会自动拼接 /chat/completions，不要手动加。
#
# 学院免费模型（教育网内网，仅校园环境可达；部署到华为云运行时调不通）：
#   1) qwen3.8-27b（编程智能体，27B 密集，推理强）
#      OPENAI_BASE_URL=http://202.204.64.234:11434/v1
#      LOGSCAN_MODEL=qwen3.8-27b
#   2) qwen3.6-35b-a3b（35B MoE，3B 激活，更快）
#      OPENAI_BASE_URL=http://59.65.232.180:18000/v1
#      LOGSCAN_MODEL=qwen3.6-35b-a3b
#   两个模型 API key 均为 ideal@2026
#
# ===== 华为云 MaaS（公网可达，大赛提供额度，推荐公网部署用）=====
# 国内版（西南-贵阳一），OpenAI 兼容接口：
#   OPENAI_BASE_URL=https://api.modelarts-maas.com/openai/v1
#   模型候选（按推荐度）：
#     deepseek-v4.1-flash-1017  ← 最新、速度快、支持 function call，推荐
#     qwen3-30b-a3b             ← 与原 qwen3.6-35b-a3b 结构最接近，迁移零成本
#     glm-5.3                   ← 长程任务强
#     kimi-k2.6                 ← 推理强
#     openpangu-2.0-flash       ← 华为盘古，性价比高
#   用法：去 MaaS 控制台开通对应预置服务 → 「API Key 管理」创建 Key
#        把 Key 填到 OPENAI_API_KEY 即可。
OPENAI_API_KEY=ideal@2026
OPENAI_BASE_URL=http://202.204.64.234:11434/v1
LOGSCAN_MODEL=qwen3.8-27b

# Agent 行为配置
LOGSCAN_MAX_STEPS=20
LOGSCAN_MAX_LOG_LINES=50000
LOGSCAN_DB_PATH=:memory:
# 思考型模型（qwen3.x）：置 1 关闭思考链，明显提速且避免正文被思考占满
LOGSCAN_DISABLE_THINKING=1
# AgentArts 运行时托管配置
AGENTARTS_RUNTIME_NAME=logscan-agent-runtime
AGENTARTS_REGION=cn-southwest-2
AGENTARTS_PORT=8080
# 运行时执行 API 的访问域名（部署后在控制台"智能体运行时"详情页"访问域名"获取）
AGENTARTS_RUNTIME_ENDPOINT=